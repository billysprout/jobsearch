# deploy/.env.example — copy to .env (setup does this for you and generates
# the token). .env holds a secret; never commit it.

# 64-hex-char token required by the config/status API and status page.
JOBSCRAPE_CONFIG_TOKEN=CHANGE_ME_64_HEX

# Loopback port for the status page / API (host side).
JOBSCRAPE_CONFIG_PORT=8790

# Daily scrape time, local wall clock (scheduler.mjs).
JOBSCRAPE_RUN_AT=07:00

# Optional: fire a run immediately when the container starts, then schedule.
# Leave unset (or 0) to wait for the scheduled hour.
#JOBSCRAPE_RUN_ON_START=1
