.env
.env.bak
node_modules/

# jobscrape runtime state — generated output, not source
jobscrape/state/
jobscrape/staging/
jobscrape/logs/

# config-server.mjs write-time snapshots + audit log — restore points, not source
jobscrape/configs/.backups/

# personal work-history/resume content used for cover-letter drafting —
# never committed; jobscrape/profile.example.md is the checked-in template
jobscrape/profile.md
# master resume source for tailor.mjs — same personal-content policy
jobscrape/resume.md

# scratch space — working notes, not durable docs
scratch/

# parity fixture: regenerated on every record/replay run — not part of the frozen fixture
jobscrape/test/fixtures/parity/state/last-run-*.json

# kit build output
installer/dist/
