# Copy of the variables setup.sh generates into .env (which is gitignored).
# Fill manually ONLY if you prefer not to run `bash setup.sh env`.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw@sha256:<digest-from-docker-inspect>
# generate with:  openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=<64-hex-char-token>
# z.ai API key (from the z.ai console; same key the local Claude Code uses
# via ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic)
ZAI_API_KEY=<your-z.ai-key>
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_TZ=UTC
